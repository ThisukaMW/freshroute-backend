generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FIELD_ADMIN
  DRIVER
  SELLER
  BUYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum ProductStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAID
  BATCHED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum BatchStatus {
  OPEN
  CLOSED
  ROUTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BatchTrigger {
  SCHEDULED
  THRESHOLD
  MANUAL
}

enum RouteStatus {
  PLANNED
  ASSIGNED
  STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum ModificationType {
  STOP_ADDED
  STOP_REMOVED
  STOP_REORDERED
  ROUTE_CHANGED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryTimeSlot {
  MORNING      // 6 AM - 12 PM
  AFTERNOON    // 12 PM - 6 PM
  EVENING      // 6 PM - 10 PM
}

enum ReservationStatus {
  ACTIVE       // Soft hold in cart
  CONFIRMED    // Hard deducted on payment
  CANCELLED    // User removed from cart
  EXPIRED      // Auto-released after timeout
}

enum HubType {
  FARM
  MARKET
  AGGREGATION_CENTER
}

enum StorageType {
  NORMAL
  COLD
}

enum TruckStorageSupport {
  NORMAL
  COLD
  BOTH
}

enum AggregationRunStatus {
  COMPLETED
  COMPLETED_WITH_REJECTIONS
  FAILED
}

enum InspectionResult {
  APPROVED
  REJECTED
  PARTIAL
}

enum AssessmentTarget {
  DRIVER
  BUYER
  SELLER
}

enum TruckType {
  REFRIGERATED_VAN
  DRY_CARGO
  REEFER
}

enum TiltRisk {
  LOW
  MEDIUM
  HIGH
}

enum StockChangeType {
  INITIAL       // Product creation
  PURCHASE      // Buyer purchases (decreases)
  RESTOCK       // Seller adds stock (increases)
  ADJUSTMENT    // Manual correction
  RETURN        // Customer return (increases)
}

// ============= USER MANAGEMENT =============

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  phone         String?     @unique
  name          String
  role          UserRole
  status        UserStatus  @default(ACTIVE)
  city          String?
  address       String?  
  addresses Address[]
  passwordHash  String
  prevPasswordHash  String?   // stores old hash before a reset, cleared after secure-account

  // Firebase Cloud Messaging token for push notifications
  fcmToken      String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relationships
  driverProfile     Driver?
  sellerProfile     Seller?
  buyerProfile      Buyer?
  fieldAdminProfile FieldAdmin? 
  notifications     Notification[]
  notificationPrefs Json?

  tokenVersion Int @default(0)

  @@index([email])
  @@index([role, status])

}

// ============= ACTOR PROFILES =============

model Driver {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber   String          @unique
  // Vehicle isn't declared at registration — trucks are matched to batches
  // separately via the fleet assignment flow (see Truck model).
  vehicleNumber   String?
  vehicleType     String?
  vehicleCapacity Float?          // in kg or cubic meters

  isActive        Boolean         @default(true)
  isAvailable     Boolean         @default(true)
  currentLat      Float?
  currentLng      Float?
  lastLocationUpdate DateTime?

  // Rating metrics
  averageRating   Float?          @default(0)
  totalRatings    Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relationships
  routes          Route[]
  locations       DriverLocation[]
  sessions        DriverSession[]
  ratings         Rating[]
  driverRatings   DriverRating[]  // ← add

  @@index([isActive, isAvailable])
  @@index([userId])
}

model Seller {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName    String
  businessAddress String
  latitude        Float?
  longitude       Float?
  verificationDocUrl String?
  isApproved      Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sellerProducts SellerProduct[]
  cartItems     CartItem[]
  reservations  StockReservation[]

  // Relationships
  products        Product[]
  pickupStops     Stop[]      @relation("SellerPickups")

  averageRating   Float       @default(0)
  totalRatings    Int         @default(0)
  ratings         Rating[]

  @@index([isApproved])
  @@index([userId])
}

model Buyer {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveryAddress String
  latitude        Float
  longitude       Float

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  orders          Order[]
  deliveryStops   Stop[]      @relation("BuyerDeliveries")
  ratings         Rating[]
  driverRatings   DriverRating[]  // ← add
  reservations    StockReservation[]

  cart            Cart?

  @@index([userId])
}

// ============= FIELD ADMIN PROFILE & TASKS =============

model FieldAdmin {
  id          String          @id @default(uuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleNumber String?
  vehicleType   String?
  isActive      Boolean      @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // relationships to tasks
  routes                Route[]
  batches               Batch[]
  inspections           ProductInspection[]
  deliveryVerifications DeliveryVerification[]
  damageReports         DamageReport[]
  assessments           Assessment[]
  refunds               Refund[]
  reassessments         RouteModification[] @relation("ReassessedBy")

  @@index([userId])
}

model Hub {
  id        String    @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  type      HubType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders    Order[]
  batches   Batch[]

  @@index([type])
  @@index([latitude, longitude])
}

model DeliveryZone {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  minLat      Float
  maxLat      Float
  minLng      Float
  maxLng      Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([isActive])
}

// ============= PRODUCTS & ORDERS =============

model Product {
  id          String          @id @default(uuid())
  sellerId    String
  seller      Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String
  price       Float
  unit        String          // kg, piece, liter, etc.
  stock       Float
  imageUrl    String?
  lowStock    Int      @default(10)
  status      ProductStatus   @default(PENDING_APPROVAL)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stockHistory    StockHistory[]

  sellerProducts SellerProduct[]

  ratings Rating[]

  // Relationships
  orderItems  OrderItem[]

  cartItems   CartItem[]

  reservations StockReservation[]

  @@index([sellerId, status])
  @@index([status])
}

model SellerProduct {
  id        String @id @default(uuid())
  productId String
  sellerId  String

  name  String   
  price Float
  stock Float

  product Product @relation(fields: [productId], references: [id])
  seller  Seller  @relation(fields: [sellerId], references: [id])

  @@unique([productId, sellerId])
}

model Order {
  id              String          @id @default(uuid())
  buyerId         String
  buyer           Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  orderNumber     String          @unique
  status          OrderStatus     @default(PENDING)
  isCancelled     Boolean         @default(false)
  totalAmount     Float
  storageType     StorageType     @default(NORMAL)
  totalWeight     Float?
  totalVolume     Float?

  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  deliveryNotes   String?
  deliveryTimeSlot DeliveryTimeSlot?
  deliveryDate    DateTime?
  specialInstructions String?

  deferredFromSlot     DeliveryTimeSlot?
  aggregationDeferCount Int              @default(0)
  lastAggregationRejectionReason String?
  lastAggregationNoticeAt DateTime?

  pickupHubId     String?
  pickupHub       Hub?            @relation(fields: [pickupHubId], references: [id], onDelete: SetNull)

  deliveryZoneId  String?
  deliveryZone    DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  batchId         String?
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  stopId          String?         @unique
  deliveryStop    Stop?           @relation(fields: [stopId], references: [id], onDelete: SetNull)

  placedAt        DateTime        @default(now())
  estimatedDelivery DateTime?
  actualDelivery  DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relationships
  items           OrderItem[]
  payment         Payment?
  ratings         Rating[]
  driverRating    DriverRating?   // ← add
  reservations    StockReservation[]
  refunds         Refund[]

  @@index([buyerId, status])
  @@index([batchId])
  @@index([status, placedAt])
  @@index([orderNumber])
  @@index([status, isCancelled, batchId, deliveryDate])
  @@index([pickupHubId, storageType])
  @@index([deliveryZoneId])
  @@index([status, batchId, deliveryTimeSlot, deferredFromSlot])
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity    Float
  unitPrice   Float
  totalPrice  Float

  sellerId    String      // Denormalized for easier querying

  inspections ProductInspection[]
  refundItems RefundItem[]
  damageReports DamageReport[]

  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model Cart {
  id        String      @id @default(uuid())
  buyerId   String      @unique
  buyer     Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items     CartItem[]
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id])
  promoCodeId String?

  expiresAt DateTime?
  lastReminderSentAt DateTime?
}

model CartItem {
  id        String    @id @default(uuid())
  cartId    String
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  sellerId  String
  seller    Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  quantity  Float
  price     Decimal?  @db.Decimal(10, 2)   // snapshot of SellerProduct.price at time of add/update
  savedForLater Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Allow same product from different sellers in cart
  @@unique([cartId, productId, sellerId])
  @@index([cartId])
  @@index([productId, sellerId])

  // Link to stock reservation
  reservation StockReservation?
}

model StockReservation {
  id             String   @id @default(uuid())

  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  sellerId       String
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  buyerId        String
  buyer          Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  quantity       Float    // How much is reserved
  status         ReservationStatus @default(ACTIVE) // ACTIVE, CONFIRMED, CANCELLED, EXPIRED

  cartItemId     String?  @unique // Link to cart
  cartItem       CartItem? @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  orderId        String?  // Link when order created
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  expiresAt      DateTime // When reservation auto-expires
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([buyerId, status])
  @@index([expiresAt]) // For cleanup job
}

model PromoCode {
  id        String   @id @default(uuid())
  code      String   @unique
  discount  Float
  active    Boolean  @default(true)

  carts     Cart[]
}

model ProductInspection {
  id            String       @id @default(uuid())
  fieldAdminId  String
  fieldAdmin    FieldAdmin   @relation(fields: [fieldAdminId], references: [id], onDelete: Cascade)

  orderItemId   String?
  orderItem     OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  result        InspectionResult
  approvedQuantity Float?
  totalQuantity Float?
  rejectedQuantity Float?
  rejectedAmount Float?
  sellerId      String?
  unit          String?
  notes         String?
  rejectionReason String?
  rejectionDetails String?
  createdAt     DateTime     @default(now())
  refundItems   RefundItem[]
  damageReports DamageReport[]

  @@index([fieldAdminId])
  @@index([orderItemId])
  @@index([sellerId])
}

model DeliveryVerification {
  id           String       @id @default(uuid())
  fieldAdminId String
  fieldAdmin   FieldAdmin   @relation(fields: [fieldAdminId], references: [id], onDelete: Cascade)

  stopId       String
  stop         Stop         @relation(fields: [stopId], references: [id], onDelete: Cascade)

  type         StopType
  verifiedAt   DateTime     @default(now())
  notes        String?

  @@index([fieldAdminId])
  @@index([stopId])
}

model DamageReport {
  id           String       @id @default(uuid())
  fieldAdminId String
  fieldAdmin   FieldAdmin   @relation(fields: [fieldAdminId], references: [id], onDelete: Cascade)

  stopId       String?
  stop         Stop?        @relation(fields: [stopId], references: [id], onDelete: Cascade)

  orderItemId  String?
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  inspectionId String?
  inspection   ProductInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  damageType   String?
  severity     String?
  affectedItems String?
  description  String
  images       Json?
  createdAt    DateTime     @default(now())

  @@index([fieldAdminId])
  @@index([stopId])
  @@index([orderItemId])
  @@index([inspectionId])
}

model Assessment {
  id             String           @id @default(uuid())
  fieldAdminId   String
  fieldAdmin     FieldAdmin       @relation(fields: [fieldAdminId], references: [id], onDelete: Cascade)

  targetUserId   String
  target         AssessmentTarget
  rating         Int
  comment        String?
  createdAt      DateTime         @default(now())

  @@index([fieldAdminId])
  @@index([targetUserId, target])
}

model Refund {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  initiatedBy   String
  fieldAdmin    FieldAdmin     @relation(fields: [initiatedBy], references: [id], onDelete: Cascade)

  amount        Float
  reason        String?
  status        PaymentStatus  @default(PENDING)
  refundItems   RefundItem[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderId])
  @@index([initiatedBy])
}

model RefundItem {
  id                String             @id @default(uuid())
  refundId           String
  refund             Refund             @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  inspectionId       String?
  inspection         ProductInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  sellerId           String
  rejectedQuantity   Float
  unitPrice          Float
  lineAmount         Float
  createdAt          DateTime           @default(now())

  @@index([refundId])
  @@index([orderItemId])
  @@index([inspectionId])
  @@index([sellerId])
}

// ============= PAYMENT SYSTEM =============

model Payment {
  id               String         @id @default(uuid())
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id])

  amount           Float
  currency         String         @default("USD")
  status           PaymentStatus  @default(PENDING)

  gatewayPaymentId String?        @unique  // Stripe/Razorpay payment ID
  gatewayResponse  Json?

  completedAt      DateTime?
  refundedAt       DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([gatewayPaymentId])
  @@index([status])
}

// ============= BATCHING SYSTEM =============

model Batch {
  id              String          @id @default(uuid())
  batchNumber     String          @unique

  status          BatchStatus     @default(OPEN)
  trigger         BatchTrigger?
  storageType     StorageType     @default(NORMAL)
  dropClusterKey  String?

  pickupHubId     String?
  pickupHub       Hub?            @relation(fields: [pickupHubId], references: [id], onDelete: SetNull)

  truckId         String?
  truck           Truck?          @relation(fields: [truckId], references: [id], onDelete: SetNull)

  fieldAdminId    String?
  fieldAdmin      FieldAdmin?     @relation(fields: [fieldAdminId], references: [id], onDelete: SetNull)

  scheduledDate   DateTime        // Target delivery date
  timeWindowStart DateTime        // e.g., 10:00 AM
  timeWindowEnd   DateTime        // e.g., 2:00 PM

  orderCount      Int             @default(0)
  totalVolume     Float           @default(0) // Total weight/volume
  capacityUsedWeight Float?       @default(0)
  capacityUsedVolume Float?       @default(0)
  maxStopsApplied Int?

  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  completedAt     DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relationships
  orders          Order[]
  routes          Route[]

  @@index([status, scheduledDate])
  @@index([scheduledDate, timeWindowStart])
  @@index([pickupHubId, storageType])
  @@index([dropClusterKey])
  @@index([truckId])
  @@index([fieldAdminId])
}

// ============= ROUTING SYSTEM =============

model Route {
  id                  String          @id @default(uuid())
  routeNumber         String          @unique

  batchId             String
  batch               Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  driverId            String?
  driver              Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)

  fieldAdminId        String?
  fieldAdmin          FieldAdmin?     @relation(fields: [fieldAdminId], references: [id], onDelete: SetNull)

  truckId             String?
  truck               Truck?          @relation(fields: [truckId], references: [id], onDelete: SetNull)

  status              RouteStatus     @default(PLANNED)

  // Route metrics
  totalDistance       Float?          // in km
  estimatedDuration   Int?            // in minutes
  actualDuration      Int?

  optimizedWaypoints  Json?           // Google Maps waypoints
  googleMapsRouteData Json?           // Full response from Google Maps API

  // Timing
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relationships
  stops               Stop[]
  modifications       RouteModification[]

  @@index([batchId])
  @@index([driverId, status])
  @@index([truckId, status])
  @@index([status, scheduledStart])
}

model Stop {
  id              String          @id @default(uuid())
  routeId         String
  route           Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)

  type            StopType
  sequenceOrder   Int             // Order in the route (1, 2, 3...)

  // Location
  address         String
  latitude        Float
  longitude       Float

  // For PICKUP stops
  sellerId        String?
  seller          Seller?         @relation("SellerPickups", fields: [sellerId], references: [id], onDelete: SetNull)

  // For DELIVERY stops
  buyerId         String?
  buyer           Buyer?          @relation("BuyerDeliveries", fields: [buyerId], references: [id], onDelete: SetNull)

  orderId         String?         @unique
  order           Order?

  status          StopStatus      @default(PENDING)

  // Timing
  estimatedArrival DateTime?
  actualArrival   DateTime?
  completedAt     DateTime?

  // Details
  notes           String?
  itemsSummary    Json?           // Products to pickup/deliver at this stop

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  deliveryVerifications DeliveryVerification[]
  damageReports          DamageReport[]

  @@index([routeId, sequenceOrder])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model RouteModification {
  id              String            @id @default(uuid())
  routeId         String
  route           Route             @relation(fields: [routeId], references: [id], onDelete: Cascade)

  type            ModificationType
  reason          String?

  approvedBy      String?           // field admin id
  approvedByFA    FieldAdmin?       @relation("ReassessedBy", fields: [approvedBy], references: [id])

  oldData         Json?             // Previous state
  newData         Json?             // New state

  createdAt       DateTime          @default(now())

  @@index([routeId, createdAt])
}

model AggregationRun {
  id                    String               @id @default(uuid())
  startedAt             DateTime             @default(now())
  completedAt           DateTime?
  dryRun                Boolean              @default(false)
  status                AggregationRunStatus @default(COMPLETED)
  windowStart           DateTime
  windowEnd             DateTime
  config                Json
  totalCandidatesFetched Int                 @default(0)
  totalEligible         Int                  @default(0)
  totalRejected         Int                  @default(0)
  totalClusters         Int                  @default(0)
  totalPackedSlices     Int                  @default(0)
  batchesCreatedCount   Int                  @default(0)
  failureReason         String?

  rejections            AggregationRunRejection[]

  @@index([startedAt])
  @@index([status])
}

model AggregationRunRejection {
  id              String         @id @default(uuid())
  runId           String
  run             AggregationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orderId         String
  orderNumber     String
  reason          String
  action          String?
  createdAt       DateTime       @default(now())

  @@index([runId])
  @@index([orderId])
}

// ============= REAL-TIME TRACKING =============

model DriverLocation {
  id              String      @id @default(uuid())
  driverId        String
  driver          Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  sessionId       String?
  session         DriverSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  latitude        Float
  longitude       Float
  accuracy        Float?      // GPS accuracy in meters
  heading         Float?      // Direction in degrees
  speed           Float?      // Speed in km/h

  timestamp       DateTime    @default(now())

  // Additional context
  currentRouteId  String?
  currentStopId   String?

  @@index([driverId, timestamp(sort: Desc)])
  @@index([sessionId])
  @@index([timestamp])
}

model DriverSession {
  id              String            @id @default(uuid())
  driverId        String
  driver          Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)

  routeId         String?

  startedAt       DateTime          @default(now())
  endedAt         DateTime?

  // Relationships
  locations       DriverLocation[]

  @@index([driverId, startedAt])
}

// ============= RATING SYSTEM =============

model Rating {
  id String @id @default(uuid())

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id])

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  rating                Int      // Overall rating (1-5)
  deliveryRating        Int?     // Delivery speed/accuracy
  productQualityRating  Int?     // Product condition on arrival
  packagingRating       Int?
  comment               String?
  images                Json?    // ← add: array of image URLs/paths
  isVerifiedPurchase    Boolean  @default(false)
  isFlagged             Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])

  @@index([sellerId])
  @@index([productId])
  @@index([driverId])
  @@index([orderId])
  @@index([buyerId])
}


model DriverRating {
  id String @id @default(uuid())

  orderId String @unique   // one driver rating per order — enforced at the DB level
  order   Order  @relation(fields: [orderId], references: [id])

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([buyerId])
}

// ============= NOTIFICATION SYSTEM =============

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  body      String
  data      Json?

  read      Boolean  @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
}

// ============= TRUCK / FLEET MANAGEMENT =============

model Truck {
  id             String    @id @default(uuid())

  // Fleet capacity dashboard (truck module)
  operator       String?
  type           String?
  capacityLbs    Float?
  loadedLbs      Float     @default(0)
  palletsLoaded  Int       @default(0)
  palletsCap     Int       @default(0)
  cratesLoaded   Int       @default(0)
  boxesLoaded    Int       @default(0)
  temperature    String    @default("Ambient")
  efficiency     Float     @default(0)
  avgDelay       String    @default("")
  loadBalanceLeft  Float   @default(50)
  loadBalanceRight Float   @default(50)
  tiltRisk       String    @default("Low")

  // Routing / aggregation fleet
  vehicleNumber      String?
  vehicleType        String?
  vehicleCapacity    Float?
  maxWeight          Float          @default(0)
  maxVolume          Float          @default(0)
  maxStops           Int?
  currentLoadWeight  Float          @default(0)
  currentLoadVolume  Float          @default(0)
  currentLoadStops   Int            @default(0)
  storageSupport     TruckStorageSupport @default(NORMAL)
  vehicleBrand       String?
  makeYear           DateTime?
  vehicleHeight      Float?
  VehicleWeight      Float?
  Refregeration      Boolean        @default(false)
  Tempreture         Float?

  isActive      Boolean      @default(true)
  isAvailable   Boolean      @default(true)

  routes        Route[]
  batches       Batch[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([operator])
  @@index([isActive, isAvailable, storageSupport])
}

// ============= INVENTORY SYSTEM =============

model StockHistory {
  id              String            @id @default(uuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  type            StockChangeType   // What type of change
  quantity        Float             // Amount changed (can be negative)
  previousStock   Float             // Stock before this change
  newStock        Float             // Stock after this change

  reason          String?           // Why changed (optional detail)
  orderId         String?           // Related order ID if applicable

  performedBy     String?           // User ID who made change (seller or admin)

  createdAt       DateTime          @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@index([type])
  @@index([orderId])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  address   String
  city      String?
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}