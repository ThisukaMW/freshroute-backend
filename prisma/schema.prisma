generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?        @unique
  name          String
  role          UserRole
  status        UserStatus     @default(ACTIVE)
  passwordHash  String
  fcmToken      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  buyerProfile  Buyer?
  driverProfile Driver?
  notifications Notification[]
  sellerProfile Seller?

  @@index([email])
  @@index([role, status])
}

model Driver {
  id                 String           @id @default(uuid())
  userId             String           @unique
  licenseNumber      String           @unique
  vehicleNumber      String
  vehicleType        String
  vehicleCapacity    Float
  isActive           Boolean          @default(true)
  isAvailable        Boolean          @default(true)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  averageRating      Float?           @default(0)
  totalRatings       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations          DriverLocation[]
  sessions           DriverSession[]
  ratings            Rating[]
  routes             Route[]

  @@index([isActive, isAvailable])
  @@index([userId])
}

model Seller {
  id              String    @id @default(uuid())
  userId          String    @unique
  businessName    String
  businessAddress String
  latitude        Float
  longitude       Float
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupStops     Stop[]    @relation("SellerPickups")

  @@index([isApproved])
  @@index([userId])
}

model Buyer {
  id              String   @id @default(uuid())
  userId          String   @unique
  deliveryAddress String
  latitude        Float
  longitude       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  ratings         Rating[]
  deliveryStops   Stop[]   @relation("BuyerDeliveries")

  @@index([userId])
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  name        String
  description String?
  category    String
  price       Float
  unit        String
  stock       Float
  imageUrl    String?
  status      ProductStatus @default(PENDING_APPROVAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItems  OrderItem[]
  seller      Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@index([status])
}

model Order {
  id                String      @id @default(uuid())
  buyerId           String
  orderNumber       String      @unique
  status            OrderStatus @default(PENDING)
  totalAmount       Float
  deliveryAddress   String
  deliveryLat       Float
  deliveryLng       Float
  deliveryNotes     String?
  batchId           String?
  stopId            String?     @unique
  placedAt          DateTime    @default(now())
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  batch             Batch?      @relation(fields: [batchId], references: [id])
  buyer             Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  deliveryStop      Stop?       @relation(fields: [stopId], references: [id])
  items             OrderItem[]
  payment           Payment?
  rating            Rating?

  @@index([buyerId, status])
  @@index([batchId])
  @@index([status, placedAt])
  @@index([orderNumber])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Float
  unitPrice  Float
  totalPrice Float
  sellerId   String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique
  amount           Float
  currency         String        @default("USD")
  status           PaymentStatus @default(PENDING)
  gatewayPaymentId String?       @unique
  gatewayResponse  Json?
  completedAt      DateTime?
  refundedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([gatewayPaymentId])
  @@index([status])
}

model Batch {
  id              String        @id @default(uuid())
  batchNumber     String        @unique
  status          BatchStatus   @default(OPEN)
  trigger         BatchTrigger?
  scheduledDate   DateTime
  timeWindowStart DateTime
  timeWindowEnd   DateTime
  orderCount      Int           @default(0)
  totalVolume     Float         @default(0)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
  routes          Route[]

  @@index([status, scheduledDate])
  @@index([scheduledDate, timeWindowStart])
}

model Route {
  id                  String              @id @default(uuid())
  routeNumber         String              @unique
  batchId             String
  driverId            String?
  fieldAdminId        String?
  status              RouteStatus         @default(PLANNED)
  totalDistance       Float?
  estimatedDuration   Int?
  actualDuration      Int?
  optimizedWaypoints  Json?
  googleMapsRouteData Json?
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  batch               Batch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  driver              Driver?             @relation(fields: [driverId], references: [id])
  modifications       RouteModification[]
  stops               Stop[]

  @@index([batchId])
  @@index([driverId, status])
  @@index([status, scheduledStart])
}

model Stop {
  id               String     @id @default(uuid())
  routeId          String
  type             StopType
  sequenceOrder    Int
  address          String
  latitude         Float
  longitude        Float
  sellerId         String?
  buyerId          String?
  orderId          String?    @unique
  status           StopStatus @default(PENDING)
  estimatedArrival DateTime?
  actualArrival    DateTime?
  completedAt      DateTime?
  notes            String?
  itemsSummary     Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order?
  buyer            Buyer?     @relation("BuyerDeliveries", fields: [buyerId], references: [id])
  route            Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  seller           Seller?    @relation("SellerPickups", fields: [sellerId], references: [id])

  @@index([routeId, sequenceOrder])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model RouteModification {
  id         String           @id @default(uuid())
  routeId    String
  type       ModificationType
  reason     String?
  approvedBy String?
  oldData    Json?
  newData    Json?
  createdAt  DateTime         @default(now())
  route      Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, createdAt])
}

model DriverLocation {
  id             String         @id @default(uuid())
  driverId       String
  sessionId      String?
  latitude       Float
  longitude      Float
  accuracy       Float?
  heading        Float?
  speed          Float?
  timestamp      DateTime       @default(now())
  currentRouteId String?
  currentStopId  String?
  driver         Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  session        DriverSession? @relation(fields: [sessionId], references: [id])

  @@index([driverId, timestamp(sort: Desc)])
  @@index([sessionId, timestamp])
  @@index([sessionId])
  @@index([timestamp])
}

model DriverSession {
  id        String           @id @default(uuid())
  driverId  String
  routeId   String?
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  locations DriverLocation[]
  driver    Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, startedAt])
  @@index([driverId, endedAt, startedAt(sort: Desc)])
}

model Rating {
  id                   String   @id @default(uuid())
  orderId              String   @unique
  driverId             String
  buyerId              String
  rating               Int
  deliveryRating       Int?
  productQualityRating Int?
  comment              String?
  createdAt            DateTime @default(now())
  buyer                Buyer    @relation(fields: [buyerId], references: [id])
  driver               Driver   @relation(fields: [driverId], references: [id])
  order                Order    @relation(fields: [orderId], references: [id])

  @@index([driverId])
  @@index([orderId])
  @@index([buyerId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
}

enum UserRole {
  ADMIN
  FIELD_ADMIN
  DRIVER
  SELLER
  BUYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAID
  BATCHED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum BatchStatus {
  OPEN
  CLOSED
  ROUTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BatchTrigger {
  SCHEDULED
  THRESHOLD
  MANUAL
}

enum RouteStatus {
  PLANNED
  ASSIGNED
  STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
}

enum StopStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum ModificationType {
  STOP_ADDED
  STOP_REMOVED
  STOP_REORDERED
  ROUTE_CHANGED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}
