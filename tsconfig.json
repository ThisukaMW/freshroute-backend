{
  "compilerOptions": {
    // File Layout
    "rootDir": ".",
    "rootDir": ".",
    "outDir": "./dist",
    // Environment Settings
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "node"
    ],
    // Interop
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}