{
  "info": {
    "name": "FreshRoute Live Demo",
    "description": "Manual trigger flow for the evaluation demo: Login -> Run Aggregator -> Plan Route -> Assign Fleet -> Auto-Dispatch Driver. Run each request top to bottom, in order — IDs are captured automatically between steps, no copy-pasting needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "adminEmail", "value": "admin@freshroute.com" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "adminToken", "value": "" },
    { "key": "batchId", "value": "" },
    { "key": "truckId", "value": "" },
    { "key": "fieldAdminId", "value": "" },
    { "key": "routeId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('adminToken', data.token);",
              "pm.test('Got admin token', () => pm.expect(data.token).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Run Aggregator (batch PAID orders)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/aggregator/run",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('At least one batch was created', () => pm.expect(data.batchesCreated?.length).to.be.above(0));",
              "if (data.batchesCreated && data.batchesCreated.length > 0) {",
              "  const batch = data.batchesCreated[0];",
              "  pm.collectionVariables.set('batchId', batch.batchId);",
              "  pm.collectionVariables.set('truckId', batch.truckId);",
              "  pm.collectionVariables.set('fieldAdminId', batch.fieldAdminId ?? '');",
              "  console.log('Captured batchId:', batch.batchId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Plan Route (calls OR-Tools optimizer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/batches/{{batchId}}/plan",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Route was planned', () => pm.expect(data.routeId).to.be.a('string'));",
              "pm.collectionVariables.set('routeId', data.routeId);",
              "console.log('Solver used:', data.solver, '| Captured routeId:', data.routeId);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Assign Fleet (truck + field admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/admin/routes/{{routeId}}/fleet",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"truckId\": \"{{truckId}}\",\n  \"fieldAdminId\": \"{{fieldAdminId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Fleet assigned OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Auto-Dispatch Driver",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/routes/{{routeId}}/auto-dispatch",
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Driver dispatched', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "console.log('Dispatch result:', JSON.stringify(data));",
              "console.log('>>> Now log into the driver mobile app to see this route appear <<<');"
            ]
          }
        }
      ]
    }
  ]
}
