# Server Configuration
PORT=5000
HOST=0.0.0.0

# Auth
JWT_SECRET=super-secret-change-me

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/freshroute

# Client URL for CORS (Frontend URL)
CLIENT_URL=http://localhost:3000
# Comma-separated allowed origins for web clients and tools.
# Keep CLIENT_URL for backward compatibility, prefer CORS_ORIGINS moving forward.
CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000,http://192.168.1.50:8081

# Minimum interval between accepted driver location updates (milliseconds).
# Set 0 to disable throttling.
LOCATION_MIN_INTERVAL_MS=0

# Node Environment
NODE_ENV=development
