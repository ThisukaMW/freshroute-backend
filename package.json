{
  "name": "freshroute-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:stop": "pkill -f 'tsx watch src/server.ts' 2>/dev/null || true; lsof -ti :5001 | xargs kill -9 2>/dev/null || true",
    "build": "tsc && mkdir -p dist/src/generated && cp -r src/generated/prisma dist/src/generated/prisma",
    "postinstall": "prisma generate",
    "start": "node dist/src/server.js",
    "test": "tsx test/run-all-tests.ts",
    "test:watch": "node --test --watch --import tsx \"test/**/*.test.ts\"",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "db:inspect": "tsx inspect-db.ts",
    "route:admin": "tsx tmp-route-admin.ts",
    "studio": "prisma studio --port 5555",
    "planner:service": "cd route-optimizer-service && uvicorn app.main:app --host 0.0.0.0 --port 8001 --reload"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/lib-storage": "^3.1112.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "density-clustering": "^1.3.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.18.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.1",
    "test": "^3.3.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/density-clustering": "^1.3.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/sinon": "^21.0.1",
    "@types/socket.io": "^3.0.2",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.6.0",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
